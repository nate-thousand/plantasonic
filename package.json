{
  "name": "plantasonic",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based generative audiovisual instrument",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "verify:runtime": "npx tsx scripts/verify-runtime.ts",
    "verify:interaction": "npx tsx scripts/verify-interaction.ts",
    "verify:visual": "npx tsx scripts/verify-visual-language.ts",
    "tokens:sync": "npx tsx scripts/sync-figma-tokens.ts sync",
    "tokens:verify": "npx tsx scripts/sync-figma-tokens.ts verify",
    "tokens:export": "npx tsx scripts/sync-figma-tokens.ts export",
    "tokens:pull": "npx tsx scripts/pull-figma-tokens.ts pull",
    "tokens:import": "npx tsx scripts/pull-figma-tokens.ts import",
    "tokens:import-json": "npx tsx scripts/import-figma-tokens-json.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "ascii-visual-engine": "file:../ascii-visual-engine",
    "bootstrap": "^5.0.2",
    "gsap": "^3.15.0",
    "plantasia-sound-engine": "github:nate-thousand/plantasia-sound-engine#1.0.0-beta.1",
    "sass": "^1.101.0"
  }
}
