{
  "name": "plantasonic",
  "private": true,
  "version": "0.2.4",
  "description": "A browser-based generative audiovisual instrument",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "verify:runtime": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-runtime.ts",
    "verify:interaction": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-interaction.ts",
    "verify:visual": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-visual-language.ts",
    "verify:integration": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-integration.ts",
    "verify:sound": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-sound-engine.ts",
    "verify:presets": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-presets.ts",
    "verify:midi": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-midi.ts",
    "verify:keyboard": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-keyboard.ts",
    "verify:generative": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-generative.ts",
    "verify:state": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-state.ts",
    "verify:design-system": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-design-system.ts",
    "verify:performance": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-performance.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "ascii-visual-engine": "github:nate-thousand/ascii-visual-engine#v0.1.0",
    "bootstrap": "^5.0.2",
    "gsap": "^3.15.0",
    "plantasia-sound-engine": "github:nate-thousand/plantasia-sound-engine#1.0.0-beta.1",
    "plantasonic-design-system": "github:nate-thousand/plantasonic-design-system#v1.2.2",
    "sass": "^1.101.0"
  }
}
