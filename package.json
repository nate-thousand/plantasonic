{
  "name": "plantasonic",
  "private": true,
  "version": "0.4.1",
  "description": "Official reference application for the Plantasonic AI First Application Platform.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "validate:app": "node scripts/validate-app.mjs",
    "verify:visual": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-visual-language.ts",
    "verify:integration": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-integration.ts",
    "verify:presets": "npx tsx --tsconfig tsconfig.verify.json scripts/verify-presets.ts",
    "verify:design-system": "node --experimental-strip-types scripts/verify-design-system.ts",
    "verify:platform": "node --experimental-strip-types scripts/verify-platform.ts",
    "verify:platform-sdk": "node --experimental-strip-types scripts/verify-platform-sdk.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@plantasonic/platform": "file:../plantasonic-platform/packages/sdk",
    "@plantasonic/platform-demo": "file:../plantasonic-platform/apps/demo",
    "@plantasonic/platform-types": "file:../plantasonic-platform/packages/shared-types",
    "ascii-visual-engine": "file:../ascii-visual-engine",
    "bootstrap": "^5.0.2",
    "plantasia-sound-engine": "file:../plantasia-sound-engine",
    "plantasonic-design-system": "file:../plantasonic-design-system",
    "sass": "^1.101.0"
  }
}
