{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Plantasonic design tokens — Figma Variables export format. Sync with npm run tokens:sync.",
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#00FF57"
    },
    "secondary": {
      "$type": "color",
      "$value": "#4DFF89"
    },
    "accent": {
      "$type": "color",
      "$value": "#4DFF89"
    },
    "surface": {
      "default": {
        "$type": "color",
        "$value": "#070F0A"
      },
      "raised": {
        "$type": "color",
        "$value": "#1A1A1A"
      },
      "sunken": {
        "$type": "color",
        "$value": "#070F0A"
      },
      "overlay": {
        "$type": "color",
        "$value": "#333333"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#4DFF89"
      },
      "secondary": {
        "$type": "color",
        "$value": "#E5E5E5"
      },
      "muted": {
        "$type": "color",
        "$value": "#999999"
      },
      "link": {
        "$type": "color",
        "$value": "{color.accent}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#4D4D4D"
      },
      "subtle": {
        "$type": "color",
        "$value": "#4D4D4D"
      },
      "strong": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.accent}"
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "#198754"
      },
      "warning": {
        "$type": "color",
        "$value": "#ffc107"
      },
      "error": {
        "$type": "color",
        "$value": "#dc3545"
      },
      "info": {
        "$type": "color",
        "$value": "#0dcaf0"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "Cascadia Code",
          "monospace"
        ]
      }
    },
    "size": {
      "base": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "display": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "h1": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "h2": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "h3": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "h4": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "body": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "body-sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "caption": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "label": {
        "$type": "dimension",
        "$value": "0.875rem"
      }
    },
    "line-height": {
      "base": {
        "$type": "number",
        "$value": 1.5
      }
    },
    "weight": {
      "headings": {
        "$type": "fontWeight",
        "$value": 600
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0"
    },
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "spacer": {
      "$type": "dimension",
      "$value": "{space.3}"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "default": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1rem"
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none"
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 0.0625rem 0.125rem rgba(0, 0, 0, 0.35)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 0.25rem 0.75rem rgba(0, 0, 0, 0.4)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 0.75rem 2rem rgba(0, 0, 0, 0.55)"
    },
    "focus": {
      "$type": "shadow",
      "$value": "0 0 0 0.2rem rgba(77, 255, 137, 0.35)"
    }
  },
  "transition": {
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "base": {
      "$type": "duration",
      "$value": "250ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "400ms"
    }
  },
  "ease": {
    "out": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    },
    "in": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    },
    "in-out": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    }
  },
  "product": {
    "nav-height": {
      "$type": "dimension",
      "$value": "3.5rem"
    },
    "dock-height": {
      "$type": "dimension",
      "$value": "4.5rem"
    },
    "sidebar-width": {
      "$type": "dimension",
      "$value": "18rem"
    },
    "shadow-overlay": {
      "$type": "shadow",
      "$value": "{shadow.lg}"
    },
    "shadow-sidebar": {
      "$type": "shadow",
      "$value": "4px 0 24px rgba(0, 0, 0, 0.4)"
    },
    "touch-target": {
      "$type": "dimension",
      "$value": "2.75rem"
    }
  }
}
